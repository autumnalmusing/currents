# Currents Orchestrator Configuration
# Multi-location weather monitoring coordination
# Uses multi-location collectors (5-10 locations per process) for efficient resource usage

[orchestrator]
storage_path = "/var/lib/currents/orchestrator.db"
analysis_interval = 3600  # 1 hour
health_check_interval = 300  # 5 minutes
batch_size = 5  # Locations per collector process (5-10 recommended)
max_locations_per_collector = 10
global_api_limit = 1000  # Global daily API call limit across all locations (optional)

# Location configurations
[orchestrator.locations.london]
name = "London, UK"
coordinates = [51.5074, -0.1278]
weather.api_key = "your-weatherapi-key"
weather.provider = "weatherapi"
weather.units = "metric"
weather.collection_interval = 1800  # 30 minutes
collection_strategy = "interval"

[orchestrator.locations.tokyo]
name = "Tokyo, JP"
coordinates = [35.6762, 139.6503]
weather.api_key = "your-weatherapi-key"
weather.provider = "weatherapi"
weather.units = "metric"
weather.collection_interval = 1800  # 30 minutes
collection_strategy = "interval"

