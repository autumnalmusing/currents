# Currents Orchestrator Configuration with Logical Regions
# Multi-location weather monitoring with region-based collector grouping

[orchestrator]
storage_path = "/var/lib/currents/orchestrator.db"
analysis_interval = 3600  # 1 hour
health_check_interval = 300  # 5 minutes
default_batch_size = 5  # Default locations per collector process
global_api_limit = 2000  # Global daily API call limit across all regions (optional)

# Region configurations
[regions.europe]
name = "Europe"
description = "European weather monitoring"
max_locations = 15
batch_size = 5  # 5 locations per collector in this region
priority = 8  # High priority region

[regions.asia]
name = "Asia"
description = "Asian weather monitoring"
max_locations = 20
batch_size = 8  # 8 locations per collector in this region
priority = 7

[regions.americas]
name = "Americas"
description = "North and South American weather monitoring"
max_locations = 25
batch_size = 10  # 10 locations per collector in this region
priority = 6

[regions.oceania]
name = "Oceania"
description = "Australia and Pacific weather monitoring"
max_locations = 10
batch_size = 5
priority = 5

# Location configurations with region assignments
[orchestrator.locations.london]
name = "London, UK"
coordinates = [51.5074, -0.1278]
region = "europe"  # Assign to Europe region
weather.api_key = "your-weatherapi-key"
weather.provider = "weatherapi"
weather.units = "metric"
weather.collection_interval = 1800
collection_strategy = "interval"

[orchestrator.locations.paris]
name = "Paris, France"
coordinates = [48.8566, 2.3522]
